{
  "useLLMProcessing": false,
  "llmProvider": "openai",
  "customProviders": [],
  "openaiKey": "",
  "openaiModel": "gpt-4o-mini",
  "geminiKey": "",
  "geminiModel": "gemini-2.0-flash",
  "claudeKey": "",
  "claudeModel": "claude-sonnet-4-20250514",
  "prompt": "Please process the following YouTube video transcript. Your task is to:\n\n1. Create an accurate and complete transcription with complete sentences\n2. Remove all self-promotion, calls to action, and promotional content (e.g., \"like and subscribe\", \"check out my channel\", \"visit my website\", etc.)\n3. Maintain the original meaning and context\n4. Ensure proper grammar and sentence structure\n5. Keep the content focused on the actual video content\n\nReturn only the cleaned transcript without any additional commentary or explanation.",
  "openaiTimeout": 1,
  "includeVideoUrl": false,
  "generateSummary": false,
  "tagWithChannelName": false,
  "includeTimestamps": true,
  "timestampFrequency": 0,
  "includeTimestampsInLLM": false,
  "localVideoDirectory": "",
  "savedDirectories": [],
  "defaultDirectory": null,
  "fileFormats": [
    "markdown"
  ],
  "createNewFile": false,
  "createCoverNote": false,
  "coverNoteLocation": "",
  "attachmentFolder": "",
  "defaultSrtFileName": "{VideoName}",
  "coverNoteTemplate": "",
  "defaultCoverNoteName": "{VideoName}",
  "singleLineTranscript": false,
  "preferredLanguage": "",
  "forceLLMLanguage": false,
  "defaultNoteName": "{VideoName}",
  "checkForDuplicates": false,
  "duplicateCheckProperty": "url",
  "allowClipboardAccess": true,
  "frontmatterFields": {
    "title": {
      "enabled": true,
      "key": "title"
    },
    "url": {
      "enabled": true,
      "key": "url"
    },
    "videoId": {
      "enabled": true,
      "key": "videoId"
    },
    "channel": {
      "enabled": true,
      "key": "channel"
    },
    "channelId": {
      "enabled": true,
      "key": "channelId"
    },
    "duration": {
      "enabled": true,
      "key": "duration"
    },
    "views": {
      "enabled": true,
      "key": "views"
    },
    "published": {
      "enabled": true,
      "key": "published"
    },
    "description": {
      "enabled": true,
      "key": "description"
    },
    "isLive": {
      "enabled": true,
      "key": "isLive"
    },
    "isPrivate": {
      "enabled": true,
